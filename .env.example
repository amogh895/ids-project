# Database
DATABASE_URL=postgresql+asyncpg://ids_user:ids_password@localhost:5432/ids_db

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# MLflow
MLFLOW_TRACKING_URI=./mlruns

# Notifications
WEBHOOK_URL=
NOTIFY_ENABLED=false

# Drift Detection
DRIFT_CHECK_INTERVAL_SECONDS=300
DRIFT_KS_THRESHOLD=0.01
DRIFT_MIN_FEATURES_DRIFTED=3

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
